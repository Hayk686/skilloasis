# Supabase runtime pooler URL (transaction mode / port 6543 for serverless).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct URL for Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUMINA_SESSION_SECRET="replace-with-at-least-32-random-characters"

# NVIDIA API Catalog key used by both Nemotron and Gemma.
NVIDIA_API_KEY="nvapi-replace-me"

# Optional endpoint override. Model routing is fixed in the application.
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
